{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "E2E: Backend",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/venv/Scripts/python",
      "justMyCode": true,
      "preLaunchTask": "Setup Dev Environment"
    },
    {
      "name": "E2E: Client",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/client/main.py",
      "cwd": "${workspaceFolder}/client",
      "python": "${workspaceFolder}/client/venv/Scripts/python",
      "justMyCode": true,
      "preLaunchTask": "Setup Dev Environment"
    },
    {
      "name": "E2E: Dashboard",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/dashboard/lib/main.dart",
      "cwd": "${workspaceFolder}/dashboard",
      "args": [
        "-d",
        "web",
        "--web-port",
        "3000"
      ],
      "preLaunchTask": "Setup Dev Environment"
    }
  ],
  "compounds": [
    {
      "name": "Start Monorepo E2E",
      "configurations": [
        "E2E: Backend",
        "E2E: Client",
        "E2E: Dashboard"
      ],
      "stopAll": true
    }
  ]
}