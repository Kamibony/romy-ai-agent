{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "E2E: Backend",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "preLaunchTask": "Root: Setup Dev Environment"
    }
  ]
}